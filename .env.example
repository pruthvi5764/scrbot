# API Configuration for CCTV Lead Generator

# 1. Google Places API (New) - Required for discovering leads
# Enable "Places API (New)" on Google Cloud Console
GOOGLE_API_KEY=your_google_api_key_here

# 2. Outreach Pitching (Optional - automatic rule-based fallback included if not set)
# Anthropic Claude:
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Or OpenAI:
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
