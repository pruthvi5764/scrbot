# API Configuration for CCTV Lead Generator

# 1. Google Places API (New) - Required for discovering leads
# Supports either GOOGLE_API_KEY or GOOGLE_PLACES_KEY
GOOGLE_API_KEY=your_google_places_api_key_here

# 2. Multi-LLM Rotating Pitch Pool (Add one or more keys, comma-separated)
# Singular aliases also work: ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY, GROQ_API_KEY, XAI_API_KEY, GROK_API_KEY.
# Anthropic Claude (e.g. claude-3-5-haiku-20241022)
ANTHROPIC_KEYS=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# OpenAI (e.g. gpt-4o-mini)
OPENAI_KEYS=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (e.g. gemini-1.5-flash)
GEMINI_KEYS=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq (e.g. llama-3.3-70b-versatile)
GROQ_KEYS=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# xAI Grok (e.g. grok-beta)
XAI_GROK_KEYS=your_xai_grok_api_key_here
XAI_GROK_MODEL=grok-beta
